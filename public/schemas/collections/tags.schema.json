{
  "version": "1.0.0",
  "kind": "olonjs-collection-contract",
  "source": "tags",
  "dataHref": "/collections/tags/tags.json",
  "contractHref": "/schemas/collections/tags.schema.json",
  "recordKeyMustMatchItemId": true,
  "itemSchema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string",
        "description": "ui:text"
      },
      "description": {
        "type": "string",
        "description": "ui:textarea"
      },
      "accent": {
        "type": "string",
        "enum": [
          "primary",
          "accent",
          "muted"
        ],
        "description": "ui:select"
      }
    },
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description"
    ]
  }
}
